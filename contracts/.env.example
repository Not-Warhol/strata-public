# Preferred: deploy from the browser wallet with scripts/deploy-page.cjs (no key in any file).
# Only for the Hardhat deploy script:
DEPLOYER_PRIVATE_KEY=
# public address of the price signer (the server holds the matching private key)
SIGNER_ADDRESS=
PUBLIC_URL=https://straata.xyz
DROP_ID=001
DROP_NAME=STRATA. 001: Contour
DROP_SYMBOL=STRATA001
# Open edition: mint is open only inside this window (UTC). Final supply = whatever is minted by MINT_END.
MINT_START=2026-10-01T18:00:00Z
MINT_END=2026-10-08T18:00:00Z
# Receives the 5% royalties. Defaults to the deployer.
ROYALTY_RECEIVER=
# Wallet expected to deploy (becomes owner) in the browser deploy page
OWNER_ADDRESS=
